{
  "name": "browser-redirect",
  "version": "4.0.0",
  "private": true,
  "description": "Automatically redirect top level domains according to predefined rules.",
  "homepage": "https://github.com/maxmilton/browser-redirect",
  "license": "MIT",
  "author": "Max Milton <max@2okki.com>",
  "repository": "github:maxmilton/browser-redirect",
  "type": "module",
  "scripts": {
    "build": "bun build.ts",
    "lint": "bun lint:fmt && bun lint:js && bun lint:ts",
    "lint:fmt": "oxfmt --check",
    "lint:js": "oxlint --format=stylish",
    "lint:ts": "tsc --noEmit",
    "test": "bun test --only-failures",
    "test:ci": "bun test --coverage --randomize --rerun-each=3",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@maxmilton/oxlint-config": "0.0.13",
    "@maxmilton/test-utils": "0.0.18",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.14",
    "@types/chrome": "0.2.6",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  }
}
